generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// === Colors ===
model Color {
  id      String @id @default(cuid())
  name    String @unique
  // name    NameOfColor
  primary String
}

// === NextAuth ===
// Gestion de l'authentification
model Account {
  id                String  @id @default(cuid()) // id unique
  userId            String                       // id du user associé
  type              String                       // type de compte (oauth, email, etc.)
  provider          String                       // fournisseur (google, github…)
  providerAccountId String                       // id du compte chez le provider
  access_token      String?                      // token OAuth
  refresh_token     String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade) // relation avec User
  @@unique([provider, providerAccountId]) // chaque compte provider unique par user
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique       // token unique de session
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique      // email unique
  name          String
  password      String                      // mot de passe hashé
  emailVerified DateTime?
  image         String?

  accounts      Account[]                   // NextAuth relation
  sessions      Session[]
  profile       Profile?                    // relation 1:1 avec le profil détaillé
  cvs           CV[]                        // relation 1:N avec les CVs
}

// === Profil utilisateur ===
model Profile {
  id          String @id @default(cuid())
  userId      String @unique                // un profile par user
  firstName   String
  lastName    String
  phone       String?
  location    String?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  description Description?
  skills      ProfileSkillGroup[]                           // 1:N
  experiences Experience[]
  educations  Education[]
  achievements Achievement[]
  strengths Strength[]
  volunteerings Volunteering[]
  projects Project[]
  publications Publication[]
  languages Language[]
  passions Passion[]
  socialMedias SocialMedia[]
  philosophy Philosophy?
  expertises Expertise[]
  prices Price[]
  certifications Certification[]
  formations Formation[]
  competences ProfileCompetenceGroup[]
}

enum Level {
  Débutant
  Junior
  Intermédiaire
  Senior
  Expert
}

model CvHeader {
  id          String @id @default(cuid())
  title       String
  subtitle    String
  phone       String
  email       String
  location    String
  portfolio   String
  nom         String
  prenom      String
  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String @unique
}

// === Description ===
model Description {
  id          String @id @default(cuid())
  description String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String @unique
  cvDescription CvDescription?
}

model CvDescription {
  id          String @id @default(cuid())
  description   Description @relation(fields: [descriptionId], references: [id])
  descriptionId String @unique
  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String @unique
}

// === Compétences ===
model Skill {
  id   String @id @default(cuid())
  name String @unique // compétences globales
  profileSkills ProfileSkill[]
  cvSkills      CvSkill[]
}

model ProfileSkillGroup {
  id        String @id @default(cuid())
  title     String?                     // titre du groupe, optionnel
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  skills    ProfileSkill[]              // compétences dans ce groupe
  order     Int @default(0)             // pour trier les groupes
}

model ProfileSkill {
  id           String @id @default(cuid())
  skill        Skill  @relation(fields: [skillId], references: [id])
  skillId      String
  group        ProfileSkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      String
  level        Level
  @@unique([groupId, skillId]) // pas de doublon dans un groupe
}

model CvSkillGroup {
  id    String @id @default(cuid())
  title String?
  cv    CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId  String
  skills CvSkill[]
  order  Int @default(0)
}

model CvSkill {
  id      String @id @default(cuid())
  skill   Skill  @relation(fields: [skillId], references: [id])
  skillId String
  group   CvSkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String
  level   Level
  @@unique([groupId, skillId])
}

// === Compétence ===
model Competence {
  id   String @id @default(cuid())
  name String @unique // compétences globales
  profileCompetences ProfileCompetence[]
  cvCompetences      CvCompetence[]
}

model ProfileCompetenceGroup {
  id        String @id @default(cuid())
  title     String?                     // titre du groupe, optionnel
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  competences    ProfileCompetence[]              // compétences dans ce groupe
  order     Int @default(0)             // pour trier les groupes
}

model ProfileCompetence {
  id           String @id @default(cuid())
  competence        Competence  @relation(fields: [competenceId], references: [id])
  competenceId      String
  group        ProfileCompetenceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      String
  @@unique([groupId, competenceId]) // pas de doublon dans un groupe
}

model CvCompetenceGroup {
  id    String @id @default(cuid())
  title String?
  cv    CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId  String
  competences CvCompetence[]
  order  Int @default(0)
}

model CvCompetence {
  id      String @id @default(cuid())
  competence   Competence  @relation(fields: [competenceId], references: [id])
  competenceId String
  group   CvCompetenceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String
  @@unique([groupId, competenceId])
}

// === Expériences professionnelles ===
model Experience {
  id          String   @id @default(cuid())
  title       String
  company     String
  start       DateTime
  end         DateTime?
  location    String?
  description String?
  missions    MissionExperience[]
  order       Int @default(0)            
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  cvReferences CvExperience[]
}

model MissionExperience {
  id          String      @id @default(cuid())
  content     String
  experience  Experience  @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  experienceId String
}

model CvExperience {
  id          String @id @default(cuid())
  experience  Experience @relation(fields: [experienceId], references: [id])
  experienceId String
  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String
}

// === Diplomes ===
model Education {
  id        String   @id @default(cuid())
  title     String?
  school    String
  city      String?
  degree    String
  start     DateTime
  end       DateTime?
  obtained  Boolean @default(false)
  order     Int @default(0)            
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  cvReferences CvEducation[]
}

model CvEducation {
  id          String @id @default(cuid())
  education   Education @relation(fields: [educationId], references: [id], onDelete: Cascade)
  educationId String
  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String
}

// === Réalisations ===
model Achievement {
  id          String @id @default(cuid())
  title       String
  description String?
  year        Int?
  technology  String?
  order       Int @default(0)           
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  cvAchievements CvAchievement[]
}

model CvAchievement {
  id            String @id @default(cuid())
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  achievementId String
  cv            CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId          String
}

// === Atouts ===
model Strength {
  id          String @id @default(cuid())
  title       String
  icon        String?
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  order       Int @default(0)           
  cvStrengths CvStrength[]
}

model CvStrength {
  id          String @id @default(cuid())
  strength    Strength @relation(fields: [strengthId], references: [id])
  strengthId  String
  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String
}

// === Benevolat ===
model Volunteering {
  id          String @id @default(cuid())
  title       String
  organisation String
  description String?
  start       DateTime
  end         DateTime?
  location    String?
  missions    MissionVolunteering[]
  order       Int @default(0)           
  profile     Profile  @relation(fields: [profileId], references: [id])
  profileId   String
  cvVolunteerings CvVolunteering[]
}

model MissionVolunteering {
  id          String      @id @default(cuid())
  content     String
  volunteering  Volunteering  @relation(fields: [volunteeringId], references: [id], onDelete: Cascade)
  volunteeringId String
}

model CvVolunteering {
  id          String @id @default(cuid())
  volunteering   Volunteering @relation(fields: [volunteeringId], references: [id])
  volunteeringId String
  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String
}

// === Projet ===
model Project {
  id          String @id @default(cuid())
  title       String
  description String?
  location    String?
  start       DateTime
  end         DateTime?
  technology  String?
  missions    MissionProject[]
  order       Int @default(0)           
  profile     Profile  @relation(fields: [profileId], references: [id])
  profileId   String
  cvProjects  CvProject[]
}

model MissionProject {
  id          String      @id @default(cuid())
  content     String
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model CvProject {
  id          String @id @default(cuid())
  project     Project @relation(fields: [projectId], references: [id])
  projectId   String
  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String
}

// === Publication ===
model Publication {
  id          String @id @default(cuid())
  title       String
  description String?
  journalName String?
  start       DateTime
  end         DateTime?
  url         String?
  order       Int @default(0)           
  profile     Profile  @relation(fields: [profileId], references: [id])
  profileId   String
  cvPublications CvPublication[]
}

model CvPublication {
  id          String @id @default(cuid())
  publication   Publication @relation(fields: [publicationId], references: [id])
  publicationId String
  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String
}

// === Langue ===
model Language {
  id          String @id @default(cuid())
  name        String
  level       Level
  profile     Profile  @relation(fields: [profileId], references: [id])
  profileId   String
  order       Int @default(0)           
  cvLanguages CvLanguage[]
}

model CvLanguage {
  id          String @id @default(cuid())
  language   Language @relation(fields: [languageId], references: [id])
  languageId String
  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String
}

// === Passion ===
model Passion {
  id          String @id @default(cuid())
  title       String
  icon        String
  order       Int @default(0)           
  profile     Profile  @relation(fields: [profileId], references: [id])
  profileId   String
  cvPassions CvPassion[]
}

model CvPassion {
  id          String @id @default(cuid())
  passion   Passion @relation(fields: [passionId], references: [id])
  passionId String
  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String
}

// === Social Media ===
model SocialMedia {
  id            String @id @default(cuid())
  socialNetwork String
  username      String
  profile       Profile  @relation(fields: [profileId], references: [id])
  profileId     String
  order         Int @default(0)           
  cvSocialMedia CvSocialMedia[]
}

model CvSocialMedia {
  id          String @id @default(cuid())
  socialMedia   SocialMedia @relation(fields: [socialMediaId], references: [id])
  socialMediaId String
  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String
}

// === Philosophie ===
model Philosophy {
  id          String @id @default(cuid())
  citation    String
  author      String?
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String @unique
  cvPhilosophy CvPhilosophy?
}

model CvPhilosophy {
  id          String @id @default(cuid())
  philosophy   Philosophy @relation(fields: [philosophyId], references: [id])
  philosophyId String @unique
  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String @unique
}

// === Expertise ===
model Expertise {
  id          String @id @default(cuid())
  title       String
  level       Level
  order       Int @default(0)           
  profile     Profile  @relation(fields: [profileId], references: [id])
  profileId   String
  cvExpertises CvExpertise[]
}

model CvExpertise {
  id          String @id @default(cuid())
  expertise   Expertise @relation(fields: [expertiseId], references: [id])
  expertiseId String
  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String
}

// === Prix ===
model Price {
  id          String @id @default(cuid())
  title       String
  domaine     String
  icon        String?
  order       Int @default(0)           
  profile     Profile  @relation(fields: [profileId], references: [id])
  profileId   String
  cvPrices CvPrice[]
}

model CvPrice {
  id          String @id @default(cuid())
  price   Price @relation(fields: [priceId], references: [id])
  priceId String
  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String
}

// === Certification ===
model Certification {
  id          String @id @default(cuid())
  title       String
  organismeCertification String?
  order       Int @default(0)           
  profile     Profile  @relation(fields: [profileId], references: [id])
  profileId   String
  cvCertifications CvCertification[]
}

model CvCertification {
  id          String @id @default(cuid())
  certification   Certification @relation(fields: [certificationId], references: [id])
  certificationId String
  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String
}

// === Formation ===
model Formation {
  id          String @id @default(cuid())
  title       String
  organismeFormation String?
  start       DateTime
  end         DateTime?
  order       Int @default(0)           
  profile     Profile  @relation(fields: [profileId], references: [id])
  profileId   String
  cvFormations CvFormation[]
}

model CvFormation {
  id          String @id @default(cuid())
  formation   Formation @relation(fields: [formationId], references: [id])
  formationId String
  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String
}

// === CV ===
model CV {
  id       String @id @default(cuid())
  photo    String?
  title    String                                // titre du CV
  templateId String
  template   CVTemplate @relation(fields: [templateId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  modules  CVModule[]                           // modules qui composent le CV (Skills, Experiences, Education)
  // Le reste passera par modules mais ça peut me permettre de faire des appels pour récupérer les données
  headerCv CvHeader?
  skillGroups CvSkillGroup[]
  educations  CvEducation[]
  experiences CvExperience[]
  achievements CvAchievement[]
  strengths CvStrength[]
  volunteerings CvVolunteering[]
  projects CvProject[]
  publications CvPublication[]
  languages CvLanguage[]
  passions CvPassion[]
  socialMedia CvSocialMedia[]
  philosophy CvPhilosophy?
  expertises CvExpertise[]
  prices CvPrice[]
  certifications CvCertification[]
  formations CvFormation[]
  description CvDescription?
  competences CvCompetenceGroup[]
}

// === Template de CV ===
model CVTemplate {
  id       String @id @default(cuid())
  name     String                              // nom du template
  structure    Json                            // structure du template (zones, sections)
  defaultStyles Json                           // styles par défaut (fontSize, color, align, show, etc.)
  cvs           CV[]                           // CVs utilisant ce template
}

// === Item d'un module ===
model CVModuleItem {
  id         String @id @default(cuid())
  moduleId   String
  module     CVModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  itemType   String   // "cvSkillGroup", "experience", "education"
  itemId     String   // id du cvSkill / Experience / Education
}

// === Module d'un CV ===
model CVModule {
  id       String @id @default(cuid())
  title    String?          // titre du module, optionnel
  type     String           // type du module : "skill", "experience", "education"
  order    Int @default(0)  // position dans le CV
  cvId     String
  cv       CV               @relation(fields: [cvId], references: [id])
  items    CVModuleItem[]   // items liés au module
  settings Json?            // personnalisations spécifiques : fontSize, color, align, show, etc.
}