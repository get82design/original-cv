generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_TEST_URL")
}

// === Colors ===
model Color {
  id      String @id @default(cuid())
  name    String @unique
  // name    NameOfColor
  primary String
  order   Int    @default(0)
  @@unique([order])
}

// === NextAuth ===
// Gestion de l'authentification
model Account {
  id                String  @id @default(cuid()) // id unique
  userId            String                       // id du user associé
  type              String                       // type de compte (oauth, email, etc.)
  provider          String                       // fournisseur (google, github…)
  providerAccountId String                       // id du compte chez le provider
  access_token      String?                      // token OAuth
  refresh_token     String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  refresh_token_expires_in Int?
  session_state            String?  // souvent utile pour rester aligné NextAuth

  user User @relation(fields: [userId], references: [id], onDelete: Cascade) // relation avec User
  @@unique([provider, providerAccountId]) // chaque compte provider unique par user
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique       // token unique de session
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique   // hash du token brut (jamais stocker le token en clair)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([email])
}

// === Les Rôles pour gérer les accès aux abonnements ===
enum PlanRole {
  FREE
  STANDARD
  PREMIUM
  PREMIUM_PLUS_IA
}

/** Accès applicatif (admin site ≠ plan d’abonnement) */
enum UserRole {
  USER
  ADMIN
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique      // email unique
  name              String?
  password          String?                      // mot de passe hashé
  emailVerified     DateTime?
  image             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  isActive          Boolean @default(true) // si l'utilisateur est actif
  lastLoginAt       DateTime?             // date de la dernière connexion
  role              UserRole          @default(USER)

  // --- Gestion des Abonnements ---
  plan              PlanRole          @default(FREE)
  customerId        String?           @unique // ID Client Stripe (utile pour le portail de facturation)
  subscriptionEnd   DateTime?                 // Date d'expiration du forfait (gère le 1 mois, 3 mois, 1 an)

  // --- Gestion du "Pay-per-use" (Consommables) ---
  downloadCredits         Int @default(0)  // crédits payants (export sans logo) — ex. +3 pour 5€
  freeDownloadsRemaining  Int @default(0)  // stock de téléchargements gratuits (export avec logo) — cadeaux d'actions
  maxCvs                  Int @default(1)  // Nombre de CVs que l'utilisateur peut créer

  // --- Quotas Mensuels (IA) ---
  iaRequestsUsed    Int               @default(0)  // Compteur de requêtes IA ce mois-ci
  lastIaReset       DateTime          @default(now()) // Pour réinitialiser le compteur tous les mois

  // --- Relations ---
  accounts          Account[]                   // NextAuth relation
  sessions          Session[]
  profile           Profile?                    // relation 1:1 avec le profil détaillé
  cvs               CV[]                        // relation 1:N avec les CVs
  unlockedTemplates UnlockedTemplate[]
  downloadGrants    DownloadGrant[]
  downloadEvents    DownloadEvent[]
  aiEvents          AiEvent[]
  apiErrorEvents    ApiErrorEvent[]
  adminCreditLogsAsTarget AdminCreditLog[] @relation("AdminCreditLogTarget")
  adminCreditLogsAsActor  AdminCreditLog[] @relation("AdminCreditLogActor")
}

// Cadeaux de téléchargements gratuits (one-shot par raison)
model DownloadGrant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String   // ex. PROFILE_CREATED, TEMPLATE_PURCHASED, FIRST_CV_SAVED
  amount    Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, reason])
  @@index([userId])
}

/** Log d’un téléchargement CV (stats admin) */
enum DownloadVariant {
  WITH_LOGO
  WITHOUT_LOGO
}

model DownloadEvent {
  id         String          @id @default(cuid())
  createdAt  DateTime        @default(now())
  variant    DownloadVariant
  /** false si un jour on autorise un export guest */
  hadAccount Boolean         @default(true)
  userId     String?
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  cvId       String?
  cv         CV?             @relation(fields: [cvId], references: [id], onDelete: SetNull)
  templateId String?
  /** Snapshot couleur au clic DL (indépendant des changements ultérieurs du CV) */
  primaryColorName String?

  @@index([createdAt])
  @@index([variant, createdAt])
  @@index([userId])
  @@index([cvId])
  @@index([primaryColorName, createdAt])
}

/** Log d’une requête IA (stats admin + fiche user) */
enum AiFeature {
  IMPORT_CV
  REVIEW_CV
  REWRITE_SECTION
  COVER_LETTER
}

/** Mode de paiement crédits pour une action IA (hors import) */
enum AiPaymentMethod {
  FREE
  PAID
}

model AiEvent {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  feature   AiFeature
  /** ex. label de section pour REWRITE_SECTION */
  detail    String?
  /** null pour IMPORT_CV (quotas, pas de crédits) */
  paymentMethod AiPaymentMethod?
  creditsSpent  Int?
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([feature, createdAt])
  @@index([userId])
}

/** Tarifs crédits par feature IA (hors IMPORT_CV) */
model AiFeaturePrice {
  feature   AiFeature @id
  /** null = option free non proposée */
  costFree  Int?
  /** null = option paid non proposée */
  costPaid  Int?
  updatedAt DateTime  @updatedAt
}

/** Packs de crédits (vitrine / futur Stripe) */
model CreditPack {
  id              String   @id @default(cuid())
  name            String
  description     String?
  priceCents      Int
  downloadCredits Int
  freeDownloads   Int      @default(0)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  stripePriceId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/** Log d’une erreur API / tRPC (ops admin) */
model ApiErrorEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /** procédure tRPC, ex. "cv.save" */
  path      String
  /** code TRPC / HTTP sémantique, ex. INTERNAL_SERVER_ERROR */
  code      String
  message   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([code, createdAt])
  @@index([path, createdAt])
  @@index([userId])
}

/** Journal admin : qui a modifié les crédits / free DL de qui */
enum AdminCreditKind {
  DOWNLOAD_CREDITS
  FREE_DOWNLOADS
}

enum AdminCreditReason {
  ADMIN_SET
  ADMIN_SOFT_RESET
}

model AdminCreditLog {
  id        String            @id @default(cuid())
  createdAt DateTime          @default(now())
  kind      AdminCreditKind
  reason    AdminCreditReason
  /** after - before (peut être négatif) */
  delta     Int
  before    Int
  after     Int

  targetUserId String
  targetUser   User  @relation("AdminCreditLogTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  actorUserId  String?
  actorUser    User? @relation("AdminCreditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
}

// === La Table de Liaison : Pour savoir quel utilisateur a acheté quel Template Premium ===
enum UnlockMethod {
  GIFT
  CREDITS
  STRIPE
}

model UnlockedTemplate {
  id         String   @id @default(cuid())
  templateId String   // ID du template (ex: "minimalist-dark-2026")
  template   CVTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())
  method     UnlockMethod @default(GIFT)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId]) // Un utilisateur ne peut pas acheter 2 fois le même template
  @@index([unlockedAt])
  @@index([method])
}

// === Profil utilisateur ===
model Profile {
  id          String @id @default(cuid())
  userId      String @unique                // un profile par user
  firstName   String
  lastName    String
  phone       String?
  location    String?
  email       String?
  photo       String?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  description Description?
  skills      ProfileSkillGroup[]                           // 1:N
  experiences Experience[]
  educations  Education[]
  achievements Achievement[]
  strengths Strength[]
  volunteerings Volunteering[]
  projects Project[]
  publications Publication[]
  languages Language[]
  passions Passion[]
  socialMedias SocialMedia[]
  philosophy Philosophy?
  expertises Expertise[]
  prizes Prize[]
  certifications Certification[]
  formations Formation[]
  competences ProfileCompetenceGroup[]
  tags ProfileTagGroup[]
}

enum Level {
  Débutant
  Junior
  Intermédiaire
  Senior
  Expert
}

enum CvTimelineStatus {
  COMPLETED
  ABANDONED
  INTERRUPTED
}

model CvHeader {
  id          String @id @default(cuid())
  title       String
  subtitle    String?
  phone       String?
  email       String?
  location    String?
  portfolio   String?
  nom         String?
  prenom      String?
  settings    Json?

  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String @unique
  @@index([cvId])
}

// === Description ===
model Description {
  id          String @id @default(cuid())
  description String

  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String @unique
}

model CvDescription {
  id          String @id @default(cuid())
  description String

  cv          CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId        String @unique
}

// === Compétences ===
model Skill {
  id   String @id @default(cuid())
  name String @unique // compétences globales

  profileSkills ProfileSkill[]
  cvSkills      CvSkill[]
}

model ProfileSkillGroup {
  id        String @id @default(cuid())
  title     String?                     // titre du groupe, optionnel
  order     Int @default(0)             // pour trier les groupes
  skills    ProfileSkill[]              // compétences dans ce groupe
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  @@unique([profileId, order]) // pas de doublon dans un profile
}

model ProfileSkill {
  id           String @id @default(cuid())
  level        Level
  skill        Skill  @relation(fields: [skillId], references: [id])
  skillId      String
  order        Int @default(0)
  group        ProfileSkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      String

  @@unique([groupId, skillId]) // pas de doublon dans un groupe
  @@unique([groupId, order])
}

model CvSkillGroup {
  id    String @id @default(cuid())
  title String?
  order  Int @default(0)
  settings Json?
  skills CvSkill[]
  cv    CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId  String
  @@unique([cvId, order]) // pas de doublon dans un cv
}

model CvSkill {
  id      String @id @default(cuid())
  level   Level
  skill   Skill  @relation(fields: [skillId], references: [id])
  skillId String
  order   Int @default(0)
  group   CvSkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String
  @@unique([groupId, skillId])
  @@unique([groupId, order])
}

// === Compétence ===
model Competence {
  id   String @id @default(cuid())
  name String @unique // compétences globales
  profileCompetences ProfileCompetence[]
  cvCompetences      CvCompetence[]
}

model ProfileCompetenceGroup {
  id        String @id @default(cuid())
  title     String?                     // titre du groupe, optionnel
  order     Int @default(0)             // pour trier les groupes
  competences    ProfileCompetence[]              // compétences dans ce groupe
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  @@unique([profileId, order]) // pas de doublon dans un profile
}

model ProfileCompetence {
  id           String @id @default(cuid())
  competence        Competence  @relation(fields: [competenceId], references: [id])
  competenceId      String
  order        Int @default(0)
  group        ProfileCompetenceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      String
  @@unique([groupId, competenceId]) // pas de doublon dans un groupe
  @@unique([groupId, order])
}

model CvCompetenceGroup {
  id    String @id @default(cuid())
  title String?
  order  Int @default(0)
  settings Json?
  cv    CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId  String
  cvCompetences CvCompetence[]
  @@unique([cvId, order]) // pas de doublon dans un cv
}

model CvCompetence {
  id      String @id @default(cuid())
  competence   Competence  @relation(fields: [competenceId], references: [id])
  competenceId String
  order        Int @default(0)
  group   CvCompetenceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String
  @@unique([groupId, competenceId])
  @@unique([groupId, order])
}

// === Tags ===
model Tag {
  id   String @id @default(cuid())
  name String @unique // tags globales
  profileTags ProfileTag[]
  cvTags      CvTag[]
}

model ProfileTagGroup {
  id        String @id @default(cuid())
  title     String?                     // titre du groupe, optionnel
  order     Int @default(0)             // pour trier les groupes
  tags      ProfileTag[]              // tags dans ce groupe
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  @@unique([profileId, order]) // pas de doublon dans un profile
}

model ProfileTag {
  id           String @id @default(cuid())
  tag        Tag  @relation(fields: [tagId], references: [id])
  tagId      String
  order        Int @default(0)
  group        ProfileTagGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      String

  @@unique([groupId, tagId]) // pas de doublon dans un groupe
  @@unique([groupId, order])
}

model CvTagGroup {
  id    String @id @default(cuid())
  title String?
  order  Int @default(0)
  settings Json?
  tags CvTag[]
  cv    CV @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId  String
  @@unique([cvId, order]) // pas de doublon dans un cv
}

model CvTag {
  id      String @id @default(cuid())
  tag   Tag  @relation(fields: [tagId], references: [id])
  tagId String
  order   Int @default(0)
  group   CvTagGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String
  @@unique([groupId, tagId])
  @@unique([groupId, order])
}

// === Expériences professionnelles ===
model Experience {
