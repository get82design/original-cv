// === CV ===
model CV {
  id       String @id @default(cuid())
  photo    String?
  title    String                                // titre du CV
  templateId String
  template   CVTemplate @relation(fields: [templateId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  modules  CVModule[]                           // modules qui composent le CV (Skills, Experiences, Education)
  layoutGeneral Json? // layout general du CV
  /** Dénormalisé depuis layoutGeneral.defaultStyles.primaryColor.name — stats admin */
  primaryColorName String?
  // Le reste passera par modules mais ça peut me permettre de faire des appels pour récupérer les données
  headerCv CvHeader?
  skillGroups CvSkillGroup[]
  educations  CvEducation[]
  experiences CvExperience[]
  achievements CvAchievement[]
  strengths CvStrength[]
  volunteerings CvVolunteering[]
  projects CvProject[]
  publications CvPublication[]
  languages CvLanguage[]
  passions CvPassion[]
  socialMedias CvSocialMedia[]
  philosophy CvPhilosophy?
  expertises CvExpertise[]
  prizes CvPrize[]
  certifications CvCertification[]
  formations CvFormation[]
  description CvDescription?
  competences CvCompetenceGroup[]
  tagGroups CvTagGroup[]

  status CVStatus @default(DRAFT) // statut du CV, brouillon, publié, archivé
  publishedAt DateTime?

  publicSlug String? @unique // slug du CV public
  isPublic   Boolean @default(false) // si le CV est public

  isDefault Boolean @default(false) // si le CV est le CV par défaut de l'utilisateur
  previewUrl      String? // aperçu avec logo — URL fichier (/uploads/… ou S3), plus data URL
  previewUrlClean String? // aperçu sans logo — idem
  pdfUrl     String?
  pdfVersion Int @default(0) // version du PDF
  pdfGeneratedAt DateTime?
  downloadEvents DownloadEvent[]

  @@index([userId])
  @@index([templateId])
  @@index([primaryColorName])
}

enum CVStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// === Template de CV ===
model CVTemplate {
  id        String @id @default(cuid())
  name      String @unique                          // nom du template
  structure    Json                            // structure du template (zones, sections)
  defaultStyles Json                           // styles par défaut (fontSize, color, align, show, etc.)
  /** Visible dans le sélecteur produit */
  isActive   Boolean @default(true)
  /** false = free ; true = nécessite UnlockedTemplate (ou abo plus tard) */
  isPremium  Boolean @default(false)
  /** Prix catalogue en centimes (null = non tarifé / free) */
  priceCents Int?
  /** Prix catalogue en crédits DL (null = non achetable en crédits) */
  priceCredits Int?
  /** Mis en avant dans le catalogue */
  isFeatured Boolean @default(false)
  /** Ordre d’affichage (plus petit = plus haut) */
  sortOrder  Int @default(0)
  /**
   * Cadeaux à l’unlock / achat (JSON).
   * Ex. { "downloadCredits": 2, "freeDownloads": 1 }
   * Stripe / admin unlock liront ce contrat plus tard.
   */
  unlockGifts Json?
  cvs           CV[]                           // CVs utilisant ce template
  unlockedTemplates UnlockedTemplate[]         // Table de liaison pour savoir quel utilisateur a acheté quel Template Premium

  @@index([isActive, sortOrder])
  @@index([isPremium])
}

// === Item d'un module ===
model CVModuleItem {
  id         String @id @default(cuid())
  moduleId   String
  module     CVModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  itemType   CVModuleItemType
  itemId     String   // id du cvSkill / Experience / Education
  order    Int @default(0)

  @@unique([moduleId, order])
  @@index([moduleId])
  @@index([itemType, itemId])
  @@unique([moduleId, itemType, itemId])
}

enum CVModuleItemType {
  cvSkillGroup
  cvExperience
  cvEducation
  cvProject
  cvVolunteering
  cvPublication
  cvAchievement
  cvExpertise
  cvFormation
  cvCertification
  cvPrize
  cvLanguage
  cvPassion
  cvCompetenceGroup
  cvDescription
  cvPhilosophy
  cvTagGroup
}

// === Module d'un CV ===
model CVModule {
  id       String @id @default(cuid())
  title    String?          // titre du module, optionnel
  type     CVModuleType     // type du module : "skill", "experience", "education"
  column   Int @default(0)
  order    Int @default(0)  // position dans le CV
  cvId     String
  cv       CV               @relation(fields: [cvId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)  // true = itemsUse, false = itemsNoUse
  items    CVModuleItem[]   // items liés au module
  settings Json?            // personnalisations spécifiques : fontSize, color, align, show, etc.

  @@unique([cvId, column, order]) // pas de doublon dans un cv
  @@unique([cvId, type]) // 1 module de chaque type par CV
  @@index([cvId])
}

enum CVModuleType {
  skill
  experience
  education
  project
  volunteering
  publication
  achievement
  expertise
  formation
  certification
  prize
  language
  passion
  competence
  description
  philosophy
  strength   
  socialMedia 
  tag
}