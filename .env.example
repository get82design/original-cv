DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/original_cv_dev?schema=public"
DATABASE_TEST_URL="postgresql://USER:PASSWORD@localhost:5432/original_cv_test?schema=public"
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="generate-with-openssl-or-node-crypto"

# SEO : laisser false / absent jusqu’au feu vert prod (noindex + Disallow: /)
# SEARCH_INDEXING_ENABLED=true

RESEND_API_KEY=
EMAIL_FROM="OriginalCV <noreply@originalcv.com>"

GOOGLE_GENERATIVE_AI_API_KEY=

# Previews CV — Cloudflare R2 (prioritaire si toutes les vars sont remplies)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
# URL publique du bucket (r2.dev ou custom domain), sans slash final
R2_PUBLIC_URL=

# Fallback local si R2 non configuré → public/uploads/cv-previews
# PREVIEW_STORAGE_DIR=
# PREVIEW_PUBLIC_BASE_URL=/uploads/cv-previews
