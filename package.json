{
	"name": "original-cv",
	"version": "1.0.0",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"test": "vitest",
		"test:run": "vitest run",
		"db:generate": "prisma generate --schema=prisma/schema.prisma",
		"db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
		"db:push": "prisma db push --schema=prisma/schema.prisma",
		"seed": "tsx prisma/seed.ts",
		"db:test:push": "prisma db push --schema=prisma/schema.test.prisma",
		"db:test:reset": "prisma migrate reset --schema=prisma/schema.test.prisma --force --skip-seed",
		"db:studio": "prisma studio --schema=prisma/schema.prisma",
		"db:test:studio": "prisma studio --schema=prisma/schema.test.prisma",
		"test:db": "npm run db:test:push && vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"devDependencies": {
		"@types/node": "^25.2.2",
		"@types/pg": "^8.16.0",
		"@types/react": "^19.2.13",
		"@vitest/coverage-v8": "^4.1.10",
		"prisma": "^6.16.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.3.0",
		"@prisma/client": "^6.16.2",
		"@tanstack/react-query": "^5.90.20",
		"@trpc/client": "^11.9.0",
		"@trpc/next": "^11.9.0",
		"@trpc/react-query": "^11.9.0",
		"@trpc/server": "^11.9.0",
		"dotenv": "^17.2.3",
		"next": "^16.1.6",
		"pg": "^8.18.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"zod": "^4.3.6"
	}
}
