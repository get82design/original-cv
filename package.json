{
  "name": "original-cv",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run",
    "db:prod:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:prod:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:prod:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:prod:reset": "prisma migrate reset --schema=prisma/schema.prisma --force",
    "seed": "tsx prisma/seed.ts",
    "db:test:generate": "prisma generate --schema=prisma/schema.test.prisma --config=prisma.test.config.ts",
    "db:test:migrate": "prisma migrate dev --schema=prisma/schema.test.prisma --config=prisma.test.config.ts",
    "db:test:push": "prisma db push --schema=prisma/schema.test.prisma --config=prisma.test.config.ts",
    "db:test:reset": "prisma migrate reset --schema=prisma/schema.test.prisma --config=prisma.test.config.ts --force",
    "db:test:studio": "prisma studio --schema=prisma/schema.test.prisma --config=prisma.test.config.ts",
    "seed:test": "tsx prisma/seed.test.ts --config=prisma.test.config.ts"
  },
  "keywords": [],
