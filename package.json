{
	"name": "original-cv",
	"version": "1.0.0",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"dev": "next dev -p 3001",
		"build": "next build",
		"start": "next start -p 3001",
		"test": "vitest",
		"test:run": "vitest run",
		"db:generate": "prisma generate --schema=prisma/schema.prisma",
		"db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
		"db:push": "prisma db push --schema=prisma/schema.prisma",
		"seed": "tsx prisma/seed.ts",
		"db:test:push": "prisma db push --schema=prisma/schema.test.prisma",
		"db:test:reset": "prisma migrate reset --schema=prisma/schema.test.prisma --force --skip-seed",
		"db:studio": "prisma studio --schema=prisma/schema.prisma",
		"db:test:studio": "prisma studio --schema=prisma/schema.test.prisma",
		"test:db": "npm run db:test:push && vitest run",
		"test:coverage": "vitest run --coverage"
	},
